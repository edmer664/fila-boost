{
    "name": "fila-boost/filament-blueprint",
    "description": "An open-source Filament v5.x blueprint planning and review skill natively integrated with Laravel Boost and AI coding agents.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Fila-boost Contributors"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "laravel/pint": "^1.18"
    },
    "suggest": {
        "filament/filament": "Required for Filament v5.x application runtime (^5.0)",
        "laravel/boost": "Required for automated MCP discovery and agent context enhancement"
    },
    "autoload": {
        "psr-4": {
            "FilaBoost\\FilamentBlueprint\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FilaBoost\\FilamentBlueprint\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FilaBoost\\FilamentBlueprint\\FilaBoostServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
